  name: otel
  namespace: open-cluster-management-observability
spec:
  mode: deployment
  replicas: 1

  config:
    extensions:
      bearertokenauth:
        token: "eyJhbGciOiJSUzI1NiIsImtpZCI6IjhkWHhoRER4R09PM1pHRXNMSlBWTmR
